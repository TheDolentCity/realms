---
import { CssBuilder } from "../../utilities/css-builder";

interface Props {
  name: string;
  value: number;
  colorless?: boolean;
  inverse?: boolean;
}

const { name, value, colorless = false, inverse = false } = Astro.props;

const v = inverse ? 100 - value : value;
const saturate = Math.abs(v - 50) * 2.5;
const backgroundCss = new CssBuilder()
  .addClass(
    "flex w-20 h-20 mx-auto p-2 items-center justify-center text-3xl font-bold tracking-tight rounded-full border-2 bg-linear-to-t lining-nums font-num"
  )
  .addClass(
    "border-zinc-500 text-zinc-900 from-zinc-400 via-zinc-300 to-zinc-200/50 dark:text-zinc-100 dark:from-zinc-700 dark:via-zinc-800 dark:to-zinc-950/50 from-0% via-50% to-100%",
    colorless
  )
  .addClass(
    "border-green-500 text-green-900 from-green-400 via-green-300 to-green-200/50 dark:text-green-100 dark:from-green-700 dark:via-green-800 dark:to-green-950/50 from-0% via-70% to-90%",
    v >= 80 && !colorless
  )
  .addClass(
    "border-green-500 text-green-900 from-green-400 via-green-300 to-green-200/75 dark:text-green-100 dark:from-green-700 dark:via-green-800 dark:to-green-950/75 from-0% via-40% to-80%",
    v < 80 && v >= 50 && !colorless
  )
  .addClass(
    "border-zinc-500 text-zinc-900 from-zinc-400 via-zinc-300 to-zinc-200/10 dark:text-zinc-100 dark:from-zinc-700 dark:via-zinc-800 dark:to-zinc-950/10 from-0% via-40% to-80%",
    v < 50 && v >= 40 && !colorless
  )
  .addClass(
    "border-amber-500 text-amber-900 from-amber-400 via-amber-300 to-amber-200/75 dark:text-amber-100 dark:from-amber-700 dark:via-amber-800 dark:to-amber-950/75 from-0% via-20% to-40%",
    v < 40 && v >= 20 && !colorless
  )
  .addClass(
    "border-red-500 text-red-900 from-red-400 via-red-300 to-red-200/75 dark:text-red-200 dark:from-red-700 dark:via-red-800 dark:to-red-950/75 from-0% via-10% to-20%",
    v < 20 && !colorless
  )
  .build();
---

<div class="not-content inline-flex flex-col w-20 items-center">
  <div class={backgroundCss} style={{ filter: `saturate(${saturate}%)` }}>
    {value}
  </div>
  <div
    class="inline px-3 pt-1.5 rounded text-center overflow-visible text-lg leading-none tracking-wider truncate text-[--sl-color-text-invert] bg-[--sl-color-text-accent]"
    title={name}
  >
    {name}
  </div>
</div>
