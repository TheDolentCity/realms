---
import { CssBuilder } from "../../utilities/css-builder";

interface Props {
  value: number;
  title: string;
  class: string;
}

const { value, title, class: className } = Astro.props;

const saturate = Math.abs(value - 50) * 5;
const gradientCss = new CssBuilder()
  .addClass(
    "not-content grow h-6 border-2 rounded rounded-br-none justify-between items-center bg-linear-to-r text-zinc-100"
  )
  .addClass(
    "border-green-600 text-green-100 from-green-700 via-green-800 to-green-950/50 from-0% via-70% to-90%",
    value >= 80
  )
  .addClass(
    "border-green-600 text-green-100 from-green-700 via-green-800 to-green-950/75 from-0% via-40% to-80%",
    value < 80 && value >= 40
  )
  .addClass(
    "border-amber-600 text-amber-100 from-amber-700 via-amber-800 to-amber-950/75 from-0% via-20% to-40%",
    value < 40 && value >= 20
  )
  .addClass(
    "border-red-600 text-red-400 from-red-700 via-red-800 to-red-950/75 from-0% via-10% to-20%",
    value < 20
  )
  .build();
---

<div class={className}>
  <div class="flex gap-2 pb-1 items-center">
    <span class="flex-none text-2xl text-[--sl-color-white]">
      {title}
    </span>
    <div class={gradientCss} style={{ filter: `saturate(${saturate}%)` }}></div>
  </div>
  <div
    class="not-content flex flex-wrap gap-3 p-4 border-2 rounded-lg rounded-tr-none justify-between items-center border-zinc-800 bg-zinc-950/50"
  >
    <slot />
  </div>
</div>
